<?xml version="1.0" ?>
<sdf version="1.7">
  <model name="qr_kodu_yuzeyi">
    <static>true</static>

    <link name="link">
      <visual name="visual">
        <geometry>
          <plane>
            <size>2.5 2.5</size>
            <normal>0 0 1</normal>
          </plane>
        </geometry>
        <material>
          <diffuse>1 1 1 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
          <pbr>
            <metal>
              <albedo_map>model://qr_kodu_yuzeyi/materials/textures/qrcode.png</albedo_map>
              <metalness>0.0</metalness>
              <roughness>1.0</roughness>
            </metal>
          </pbr>
        </material>
      </visual>

      <collision name="collision">
        <geometry>
          <!-- çarpışma için ince box -->
          <box>
            <size>2.5 2.5 0.01</size>
          </box>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>

